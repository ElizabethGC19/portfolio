---
import { SITE } from '../../data/site';
---

<section id="inicio" class="py-16">
  <p class="text-sm font-medium text-accent">{SITE.role}</p>
  <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">Hola, soy {SITE.name}.</h1>
  <p class="mt-4 max-w-2xl text-lg text-zinc-600 dark:text-zinc-400">{SITE.description}</p>
  <div class="mt-8 flex flex-wrap gap-3">
    <a href="#proyectos" class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white hover:opacity-90">
      Ver proyectos
    </a>
    <a href="#contacto" class="rounded-lg border border-zinc-300 px-4 py-2 text-sm font-medium hover:border-accent dark:border-zinc-700">
      Contactar
    </a>
  </div>
</section>
