---
import SocialIcon from '../SocialIcon.astro';
import { SITE, SOCIAL_LINKS } from '../../data/site';

const btn = 'inline-flex items-center gap-1.5 rounded-lg border px-3 py-1.5 text-[13px] font-medium transition-colors';
const neutralBtn = `${btn} border-zinc-300 hover:border-accent hover:text-accent dark:border-zinc-700`;
// Colores de marca: azul de LinkedIn y gris oscuro de GitHub (su negro oficial no se vería en modo oscuro)
const brandBtn: Record<string, string> = {
  LinkedIn: `${btn} border-transparent bg-[#0A66C2] text-white hover:bg-[#004182]`,
  GitHub: `${btn} border-transparent bg-[#24292f] text-white hover:bg-[#32383f] dark:border-zinc-700`,
};
// LinkedIn primero, luego GitHub
const [before, after] = SITE.description.split(SITE.highlight);
const socials =['LinkedIn', 'GitHub'].flatMap((label) => SOCIAL_LINKS.filter((link) => link.label === label));
---

<section id="inicio" class="flex flex-col gap-10 py-16 sm:flex-row sm:items-center">
  <div class="size-40 shrink-0 overflow-hidden rounded-2xl sm:size-56">
    {
      SITE.photo ? (
        <img src={SITE.photo} alt={`Foto de ${SITE.name}`} width="224" height="224" class="size-full object-cover" />
      ) : (
        <div class="flex size-full items-center justify-center rounded-2xl border-2 border-dashed border-zinc-300 bg-zinc-100 text-zinc-400 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-600">
          <svg class="size-16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="8" r="4"></circle>
            <path d="M4 21a8 8 0 0 1 16 0"></path>
          </svg>
        </div>
      )
    }
  </div>

  <div class="flex-1">
    <p class="text-sm font-medium text-accent">{SITE.role}</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">Hola, soy <span class="shiny-text">{SITE.name}</span>.</h1>
    <p class="mt-6 max-w-3xl text-xl leading-relaxed text-zinc-700 sm:text-2xl dark:text-zinc-300">
      {
        after !== undefined ? (
          <>
            {before}
            <span class="font-medium text-accent">{SITE.highlight}</span>
            {after}
          </>
        ) : (
          SITE.description
        )
      }
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#proyectos" class="rounded-lg bg-accent px-3 py-1.5 text-[13px] font-medium text-white hover:opacity-90">
        Ver proyectos
      </a>
      {
        socials.map(({ href, label }) => (
          <a href={href} target="_blank" rel="noopener noreferrer" class={brandBtn[label] ?? neutralBtn}>
            <SocialIcon name={label} class="size-3.5" />
            {label}
          </a>
        ))
      }
      <a href={`mailto:${SITE.email}`} class={neutralBtn}>
        <SocialIcon name="Email" class="size-3.5" />
        Email
      </a>
    </div>
  </div>
</section>
