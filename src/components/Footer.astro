---
import SocialIcon from './SocialIcon.astro';
import { SITE, SOCIAL_LINKS } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-200 dark:border-zinc-800">
  <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-4 px-4 py-6 text-sm text-zinc-500">
    <p>© {year} {SITE.name}</p>
    <div class="flex flex-wrap items-center gap-4">
      <ul class="flex items-center gap-4">
        {
          SOCIAL_LINKS.map(({ href, label }) => (
            <li>
              <a href={href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 transition-colors hover:text-accent">
                <SocialIcon name={label} class="size-4" />
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={`mailto:${SITE.email}`}
        class="inline-flex items-center gap-1.5 rounded-2xl border border-accent px-3 py-1.5 text-[13px] font-medium text-accent transition-colors hover:bg-accent hover:text-white"
      >
        <SocialIcon name="Email" class="size-3" />
        Escríbeme
      </a>
    </div>
  </div>
</footer>
