---
import { SITE, SOCIAL_LINKS } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-200 dark:border-zinc-800">
  <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-4 px-4 py-6 text-sm text-zinc-500">
    <p>© {year} {SITE.name}</p>
    <ul class="flex gap-4">
      {
        SOCIAL_LINKS.map(({ href, label }) => (
          <li>
            <a href={href} target="_blank" rel="noopener noreferrer" class="hover:text-accent">
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
