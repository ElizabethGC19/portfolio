---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="relative mb-8 border-b border-zinc-200 pb-5 dark:border-zinc-800">
  <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-2 text-zinc-600 dark:text-zinc-400">{subtitle}</p>}
  <!-- Tramo verde sobre la línea divisoria -->
  <span class="absolute -bottom-px left-0 h-px w-16 bg-accent" aria-hidden="true"></span>
</div>
