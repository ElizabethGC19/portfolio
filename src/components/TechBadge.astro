---
import { getTech } from '../data/tech';

interface Props {
  name: string;
}

const { name } = Astro.props;
const tech = getTech(name);
const color = tech && `#${tech.hex}`;
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-medium',
    !tech && 'border-transparent bg-zinc-100 dark:bg-zinc-800',
  ]}
  style={color && {
    backgroundColor: `color-mix(in srgb, ${color} 18%, transparent)`,
    borderColor: `color-mix(in srgb, ${color} 45%, transparent)`,
  }}
>
  {
    tech && (
      <svg class="size-3 shrink-0" viewBox="0 0 24 24" fill={color} aria-hidden="true">
        <path d={tech.path} />
      </svg>
    )
  }
  {name}
</span>
